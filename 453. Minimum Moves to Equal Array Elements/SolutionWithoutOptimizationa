package main

import (
	"fmt"
)

func main() {

	fmt.Println(minMoves([]int{1, 2, 1}))
}

func minMoves(nums []int) int {
	if len(nums) == 1 {
		return 0
	}
	steps := 0
	for nums[0]*len(nums) != sums(nums) {
		bubbleSort(nums)
		for i := 0; i < len(nums)-1; i++ {
			nums[i]++
		}
		steps++

	}
	return steps

}
func sums(nums []int) int {
	counts := 0
	for _, i := range nums {
		counts += i
	}
	return counts
}

func bubbleSort(a []int) []int {
	for i := 0; i < len(a)-1; i++ {
		for j := 0; j < len(a)-1-i; j++ {
			if a[j] > a[j+1] {
				a[j], a[j+1] = a[j+1], a[j]
			}
		}

	}
	return a
}
